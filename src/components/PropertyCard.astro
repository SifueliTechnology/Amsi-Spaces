---
import type { Project } from '@/lib/palmera';
import { formatPrice } from '@/lib/currency';
import { shouldShowPermit } from '@/lib/palmera';

interface Props {
  property: Project;
}
const { property } = Astro.props;
const statusLabel: Record<string, string> = {
  OFF_PLAN: 'Off-plan',
  UNDER_CONSTRUCTION: 'Under construction',
  READY: 'Ready',
};
---
<article class="group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white transition hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden bg-sand-100">
    <img
      src={property.image.card}
      srcset={property.image.srcset}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
      alt={property.title}
      loading="lazy"
      class="h-full w-full object-cover transition group-hover:scale-105"
    />
    <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-xs font-medium text-ink-900 shadow-sm">
      {statusLabel[property.completionStatus] ?? property.completionStatus}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="font-serif text-lg font-semibold text-ink-900">{property.title}</h3>
    <p class="text-sm text-ink-500">{property.developerName}</p>
    <p class="text-sm text-ink-500 capitalize">
      {property.emirate?.replace(/-/g, ' ')}{property.area ? `, ${property.area.replace(/-/g, ' ')}` : ''}
    </p>
    <div class="mt-1 flex items-baseline justify-between">
      <span class="text-lg font-semibold text-ink-900">
        {property.priceOnApplication ? 'Price on application' : formatPrice(property.priceFrom, property.currency)}
      </span>
      {property.handoverDate && <span class="text-xs text-ink-500">Handover {property.handoverDate}</span>}
    </div>
    {shouldShowPermit(property) && (
      <p class="text-xs text-ink-500">DLD permit {property.permitNumber}</p>
    )}
    <div class="mt-3 flex flex-col gap-2 sm:flex-row">
      <a
        href={property.shareUrl}
        target="_blank"
        rel="noopener sponsored"
        class="btn-primary flex-1 text-center"
        data-analytics="view-project"
        data-project-slug={property.slug}
      >
        View project
      </a>
      <a
        href={`#enquiry?project=${property.slug}&source=${property.source}&id=${property.id}`}
        class="btn-secondary flex-1 text-center"
        data-enquiry-project-title={property.title}
        data-enquiry-project-source={property.source}
        data-enquiry-project-id={property.id}
      >
        Ask Amsi about this
      </a>
    </div>
  </div>
</article>
