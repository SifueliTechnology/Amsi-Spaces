---
// Shared enquiry footer — appears on Home, Properties, Resources, Blog.
// Now backed by the real Palmera Partner API (Track B): when a visitor
// enquires about a specific project and ticks the required consent box,
// /api/lead both saves the enquiry in D1 AND registers a lead with Palmera
// via POST /leads (idempotent, consent-gated) — see src/pages/api/lead.ts.
// General enquiries with no project attached are just saved in D1; there's
// nothing to register with Palmera for those.
interface Props {
  interestChips?: string[];
  context?: string; // e.g. a property title, pre-filled when arriving from a card
  projectSource?: string; // Palmera project.source, when context is a specific property
  projectId?: string; // Palmera project.id, when context is a specific property
}
const {
  interestChips = ['Buy', 'Invest', 'Finance', 'Tools & courses', 'E-guides', 'Something else'],
  context,
  projectSource,
  projectId,
} = Astro.props;
const CONSENT_VERSION = 'v1-2026-09';
---
<section id="enquiry" class="border-t border-sand-200 bg-white py-14">
  <div class="container-page grid gap-10 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold text-ink-900 sm:text-3xl">Ask Amsi</h2>
      <p class="mt-3 max-w-md text-ink-700">
        Michael reviews every message personally. If you tick "I agree to be contacted" and this
        is about a specific project, your interest is registered with the partner right away —
        Michael still follows up with you himself.
      </p>
      <p id="enquiry-context" class="mt-4 rounded-lg bg-sand-100 px-3 py-2 text-sm text-ink-700" hidden={!context}>
        Re: <strong id="enquiry-context-title">{context ?? ''}</strong>
      </p>
    </div>
    <form id="enquiry-form" class="flex flex-col gap-4 rounded-2xl border border-sand-200 bg-sand-50 p-6">
      <fieldset class="flex flex-wrap gap-2">
        <legend class="mb-2 text-sm font-medium text-ink-900">What are you interested in?</legend>
        {interestChips.map((chip) => (
          <label class="cursor-pointer">
            <input type="radio" name="interest" value={chip} class="peer sr-only" />
            <span class="inline-block rounded-full border border-ink-900/15 px-3 py-1.5 text-sm text-ink-700 peer-checked:border-amsi peer-checked:bg-amsi peer-checked:text-white">
              {chip}
            </span>
          </label>
        ))}
      </fieldset>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-1 text-sm text-ink-700">
          Name
          <input required name="name" type="text" class="rounded-lg border border-ink-900/15 px-3 py-2" />
        </label>
        <label class="flex flex-col gap-1 text-sm text-ink-700">
          Email
          <input required name="email" type="email" class="rounded-lg border border-ink-900/15 px-3 py-2" />
        </label>
        <label class="flex flex-col gap-1 text-sm text-ink-700">
          Phone (optional, but needed for Palmera to register your interest)
          <input name="phone" type="tel" placeholder="+971501234567" class="rounded-lg border border-ink-900/15 px-3 py-2" />
        </label>
        <label class="flex flex-col gap-1 text-sm text-ink-700">
          Preferred contact
          <select name="contactPreference" class="rounded-lg border border-ink-900/15 px-3 py-2">
            <option>Email</option>
            <option>Phone</option>
            <option>WhatsApp</option>
          </select>
        </label>
      </div>

      <label class="flex flex-col gap-1 text-sm text-ink-700">
        Message
        <textarea name="message" rows="3" class="rounded-lg border border-ink-900/15 px-3 py-2"></textarea>
      </label>

      <input type="hidden" name="projectReference" id="enquiry-project-reference" value={context ?? ''} />
      <input type="hidden" name="projectSource" id="enquiry-project-source" value={projectSource ?? ''} />
      <input type="hidden" name="projectId" id="enquiry-project-id" value={projectId ?? ''} />
      <input type="hidden" name="sourcePage" value={Astro.url.pathname} />
      <input type="hidden" name="consentTextVersion" value={CONSENT_VERSION} />

      <label class="flex items-start gap-2 text-sm text-ink-700">
        <input required type="checkbox" name="consentContact" class="mt-1" />
        <span>
          I agree to be contacted by Amsi Spaces — and, if this is about a specific project, by
          that partner — about my enquiry, per the
          <a href="/privacy" class="underline hover:text-amsi">Privacy Policy</a>. Required.
        </span>
      </label>
      <label class="flex items-start gap-2 text-sm text-ink-700">
        <input type="checkbox" name="consentMarketing" class="mt-1" />
        <span>I'd also like occasional market updates and new listings. Optional.</span>
      </label>

      <!-- Turnstile widget mounts here in production; data-sitekey set via env at build/deploy. -->
      <div class="cf-turnstile" data-sitekey="REPLACE_WITH_TURNSTILE_SITE_KEY"></div>
      <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off" />

      <button type="submit" class="btn-primary">Send to Amsi</button>
      <p id="enquiry-status" class="text-sm" role="status"></p>
    </form>
  </div>
</section>
<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('enquiry-status');
  const contextEl = document.getElementById('enquiry-context');
  const contextTitleEl = document.getElementById('enquiry-context-title');
  const refInput = document.getElementById('enquiry-project-reference') as HTMLInputElement | null;
  const sourceInput = document.getElementById('enquiry-project-source') as HTMLInputElement | null;
  const idInput = document.getElementById('enquiry-project-id') as HTMLInputElement | null;

  // Any "Ask Amsi about this" link on the page (property cards, property
  // detail sidebar, blog CTA) carries data-enquiry-project-* attributes.
  // Delegate from `document` (rather than binding each link individually) so
  // this also covers cards injected later via /api/properties innerHTML
  // swaps on the Properties page. Intercept the click so we populate the
  // form's hidden fields AND scroll to it properly — a literal
  // `#enquiry?project=...` href would not match the section's id="enquiry"
  // and would silently fail to scroll at all.
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a[href^="#enquiry"]');
    if (!link) return;
    e.preventDefault();
    const title = link.dataset.enquiryProjectTitle;
    const source = link.dataset.enquiryProjectSource;
    const id = link.dataset.enquiryProjectId;
    if (title) {
      if (refInput) refInput.value = title;
      if (contextTitleEl) contextTitleEl.textContent = title;
      if (contextEl) contextEl.hidden = false;
    }
    if (source && sourceInput) sourceInput.value = source;
    if (id && idInput) idInput.value = id;
    document.getElementById('enquiry')?.scrollIntoView({ behavior: 'smooth' });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    status.textContent = 'Sending...';
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error('request failed');
      status.textContent = "Thanks — Michael will get back to you personally.";
      form.reset();
    } catch {
      status.textContent = "Something went wrong sending that. Please email michael@amsispaces.com directly.";
    }
  });
</script>
