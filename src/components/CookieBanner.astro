---
// Essential / Analytics / Advertising cookie categories, per brief Section 4
// (legal pages spec). Stores the choice in localStorage on the real site
// domain — this is a persisted page, not a conversation preview artifact,
// so localStorage is fine here.
---
<div id="cookie-banner" class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-sand-200 bg-white p-4 shadow-lg sm:p-6" role="dialog" aria-label="Cookie preferences">
  <div class="container-page flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-ink-700 max-w-2xl">
      We use essential cookies to run this site, and optional analytics/advertising cookies to
      understand traffic and measure referrals. See our
      <a href="/privacy" class="underline hover:text-amsi">Privacy Policy</a>.
    </p>
    <div class="flex flex-wrap gap-2">
      <button id="cookie-essential-only" class="btn-secondary text-xs">Essential only</button>
      <button id="cookie-accept-all" class="btn-primary text-xs">Accept all</button>
    </div>
  </div>
</div>
<script>
  const KEY = 'amsi-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  try {
    if (!localStorage.getItem(KEY)) {
      banner?.classList.remove('hidden');
    }
  } catch {
    // localStorage unavailable (private browsing etc.) — leave banner hidden,
    // essential cookies still function without consent tracking.
  }
  document.getElementById('cookie-accept-all')?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, JSON.stringify({ essential: true, analytics: true, advertising: true, at: Date.now() }));
    } catch {}
    banner?.classList.add('hidden');
  });
  document.getElementById('cookie-essential-only')?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, JSON.stringify({ essential: true, analytics: false, advertising: false, at: Date.now() }));
    } catch {}
    banner?.classList.add('hidden');
  });
</script>
