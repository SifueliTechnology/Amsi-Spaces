---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Amsi Spaces — a referral partner for off-plan real estate, financing, tools and courses across UAE, Cyprus, Oman, Saudi Arabia and Georgia.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Amsi Spaces</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Cloudflare Turnstile, loaded sitewide since the enquiry footer appears on every page -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
