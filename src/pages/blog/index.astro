---
export const prerender = true; // static content only, no Cloudflare bindings needed

import BaseLayout from '@/layouts/BaseLayout.astro';
import { blogPosts } from '@/data/blogPosts';
import { markets } from '@/data/markets';

const marketChips = [...markets.map((m) => ({ slug: m.slug, name: m.name })), { slug: 'global', name: 'Global / Market trends' }];
const categoryChips = ['Buying', 'Renting', 'Investing', 'Financing', 'Tools'];
---
<BaseLayout title="Blog" description="Buying, investing and financing guides across UAE, Cyprus, Oman, Saudi Arabia and Georgia.">
  <div class="container-page py-10">
    <h1 class="text-3xl font-semibold text-ink-900 sm:text-4xl">Blog</h1>

    <div class="mt-6 space-y-3">
      <div class="flex flex-wrap gap-2">
        {marketChips.map((m) => (
          <button class="market-chip rounded-full border border-ink-900/15 px-3 py-1.5 text-sm" data-market={m.slug}>{m.name}</button>
        ))}
      </div>
      <div class="flex flex-wrap gap-2">
        {categoryChips.map((c) => (
          <button class="category-chip rounded-full border border-ink-900/15 px-3 py-1.5 text-sm" data-category={c}>{c}</button>
        ))}
      </div>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {blogPosts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="post-card flex flex-col rounded-2xl border border-sand-200 bg-white p-6 transition hover:shadow-lg"
          data-market={post.market}
          data-category={post.category}
        >
          <p class="text-xs font-medium uppercase tracking-wide text-amsi">{post.category} &middot; {post.market === 'global' ? 'Global' : post.market.toUpperCase()}</p>
          <h2 class="mt-2 font-serif text-lg font-semibold text-ink-900">{post.title}</h2>
          <p class="mt-2 flex-1 text-sm text-ink-700">{post.excerpt}</p>
          <p class="mt-4 text-xs text-ink-500">{new Date(post.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const marketChips = document.querySelectorAll('.market-chip');
  const categoryChips = document.querySelectorAll('.category-chip');
  const posts = document.querySelectorAll('.post-card');
  let activeMarket = null;
  let activeCategory = null;

  function apply() {
    posts.forEach((p) => {
      const matchesMarket = !activeMarket || p.dataset.market === activeMarket;
      const matchesCategory = !activeCategory || p.dataset.category === activeCategory;
      p.style.display = matchesMarket && matchesCategory ? '' : 'none';
    });
  }
  marketChips.forEach((chip) => chip.addEventListener('click', () => {
    activeMarket = activeMarket === chip.dataset.market ? null : chip.dataset.market;
    marketChips.forEach((c) => c.classList.toggle('chip-active', c === chip && activeMarket));
    apply();
  }));
  categoryChips.forEach((chip) => chip.addEventListener('click', () => {
    activeCategory = activeCategory === chip.dataset.category ? null : chip.dataset.category;
    categoryChips.forEach((c) => c.classList.toggle('chip-active', c === chip && activeCategory));
    apply();
  }));
</script>

<style>
  .chip-active { @apply border-amsi bg-amsi text-white; }
</style>
