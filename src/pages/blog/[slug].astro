---
export const prerender = true; // static content only, no Cloudflare bindings needed

import BaseLayout from '@/layouts/BaseLayout.astro';
import DisclosureBanner from '@/components/DisclosureBanner.astro';
import LabelPill from '@/components/LabelPill.astro';
import EnquiryFooter from '@/components/EnquiryFooter.astro';
import { blogPosts } from '@/data/blogPosts';
import { getMarket } from '@/data/markets';

export async function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const market = getMarket(post.market);
const ctaMarketLabel = market ? market.name : 'your market';
---
<BaseLayout title={post.title} description={post.excerpt}>
  <article class="container-page max-w-3xl py-10">
    <p class="text-xs font-medium uppercase tracking-wide text-amsi">{post.category} &middot; {market ? market.name : 'Global'}</p>
    <h1 class="mt-2 text-3xl font-semibold text-ink-900 sm:text-4xl">{post.title}</h1>
    <p class="mt-2 text-sm text-ink-500">{new Date(post.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</p>

    {(post.promotes) && (
      <div class="mt-6"><DisclosureBanner compact /></div>
    )}

    {post.stat && (
      <div class="mt-8 rounded-2xl border border-sand-200 bg-sand-100 p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">At a glance</p>
        <p class="mt-1 text-2xl font-semibold text-ink-900">{post.stat.value}</p>
        <p class="text-sm text-ink-700">{post.stat.label}</p>
      </div>
    )}

    <div class="prose prose-sand mt-8 max-w-none prose-headings:font-serif prose-a:text-amsi">
      <p>{post.body}</p>
    </div>

    {post.promotes && (
      <div class="mt-10 rounded-2xl border border-sand-200 bg-white p-6">
        <div class="flex items-center gap-2">
          <LabelPill label={post.promotes.kind === 'property' ? 'referral-partner' : 'sponsored'} />
        </div>
        <a href={post.promotes.href} class="mt-3 inline-block font-medium text-amsi hover:underline">
          {post.promotes.label} &rarr;
        </a>
      </div>
    )}

    <div class="mt-10">
      <a href={`#enquiry`} class="btn-primary">Ask Amsi about {ctaMarketLabel}</a>
    </div>
  </article>

  <EnquiryFooter context={post.title} />
</BaseLayout>
